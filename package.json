{
  "name": "collabdraw",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "node --env-file-if-exists=.env server/src/index.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:check": "node --env-file-if-exists=.env scripts/db-check.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.3.1",
    "canvas": "^3.0.0-rc3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "nanoid": "^3.3.11",
    "next": "15.2.8",
    "perfect-freehand": "^1.2.2",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "roughjs": "^4.6.6",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.2.8",
    "globals": "^17.12.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.1.1"
  }
}
