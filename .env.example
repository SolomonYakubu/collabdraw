# ---------------------------------------------------------------------------
# AI model configuration
#
# Any ONE of these keys configures the assistant; whichever is present wins:
#   GEMINI_API_KEY      - Google AI Studio
#   OPENAI_API_KEY      - OpenAI
#   OPENROUTER_API_KEY  - OpenRouter (hundreds of models from many vendors)
#
# Or point at any OpenAI-compatible server (Groq, Together, Ollama, LM Studio...):
#   AI_API_KEY=...
#   AI_PROVIDER=custom
#   AI_BASE_URL=http://localhost:11434/v1
#
# Optional overrides:
#   AI_PROVIDER=gemini|openai|openrouter|custom   (default: detected from key)
#   AI_MODEL=<model name>                         (default per provider)
#   AI_BASE_URL=<api root>                        (custom provider only)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Public site URL
#
# Used as metadataBase so Open Graph / Twitter image URLs resolve to absolute
# links for social scrapers. Set this to your production origin on deploy,
# e.g. https://collabdraw.example.com
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Production collaboration infrastructure
# ---------------------------------------------------------------------------
# Shared Redis is required for multiple socket instances and durable snapshots.
# Set REQUIRE_REDIS=true in production so a missing Redis connection fails fast.
REDIS_URL=redis://localhost:6379
REQUIRE_REDIS=false
CLIENT_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Database (Neon Postgres) — durable board storage
#
# DATABASE_URL          pooled connection string (host contains "-pooler"),
#                       used by the Next.js app and the socket server at runtime.
# DATABASE_URL_UNPOOLED direct (non-pooler) string, used ONLY by the migration
#                       runner (`npm run db:migrate`); the pooler rejects some
#                       session/DDL features.
#
# TLS follows the string: verified for a remote host, skipped for localhost or
# an explicit sslmode=disable, unverified only with sslmode=no-verify. Prefer
# sslmode=verify-full — `pg` warns that it treats plain `require` as verify-full
# today and will stop doing so in v9. A local server works just as well:
#   DATABASE_URL=postgres://you@localhost:5432/collabdraw?sslmode=disable
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgres://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=verify-full

# Start the background worker with this set to a module exporting
# async ({ data }) => result. Keep the worker separate from the web process.
# GENERATION_PROCESSOR_MODULE=./processors/generateDrawing.js
